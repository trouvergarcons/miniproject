# Example environment variables for local development (DO NOT COMMIT SECRETS)
# Copy this file to `.env` and fill in actual values.

# PostgreSQL connection used by Prisma (example)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Public frontend API base (used by the client to call backend)
NEXT_PUBLIC_API_URL="http://127.0.0.1:3000/api"

# Optional: Google Generative AI / search API key (replace with your key if required)
GOOGLE_GENERATIVE_AI_API_KEY="your_api_key_here"
# Example environment variables for frontend
# Copy to .env.local or .env and fill with your values (DO NOT commit secrets)

# Prisma / Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Google Generative AI (if using Gemini integration)
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GOOGLE_GENERATIVE_AI_API_KEY

# Optional: other keys used by the app
# NEXT_PUBLIC_SOME_KEY=your_value_here
